# ─────────────────────────────────────────────────────────────────────────────
# TradingAgents — Production environment (docker-compose.prod.yml)
#
# Copy to .env.production (gitignored, never committed) and fill in real
# values. This is separate from ./secrets/ (create_secrets.sh) because these
# values need to reach Caddy as environment-variable substitutions in
# deploy/Caddyfile ({$VAR}), which Docker secrets files can't do — same
# split WiseWire's fenceaware-server uses for ACME_EMAIL/API_DOMAIN/JWT_SECRET.
#
# Usage:
#   cp .env.production.example .env.production
#   # edit the values below
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain / TLS ──────────────────────────────────────────────────────────────
DOMAIN=focusario.com
# A real address — Let's Encrypt uses this only to warn you if a renewal is
# about to fail, never anything public-facing.
ACME_EMAIL=you@example.com

# ── Basic Auth (Caddy) ────────────────────────────────────────────────────────
BASIC_AUTH_USER=admin
# NOT a plaintext password — a bcrypt hash. Generate with (see DEPLOYMENT.md
# step 6 for the full walkthrough):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password-here'
# Paste the full $2a$... output below, single line, no quotes needed.
BASIC_AUTH_HASH=

# ── Storage ───────────────────────────────────────────────────────────────────
# Path on the HOST (Linode VM) where your Block Storage volume is mounted.
# Linode typically mounts volumes at /mnt/<label> — adjust to match yours.
REPORTS_HOST_PATH=/mnt/reports

# ── Reddit (non-sensitive) ────────────────────────────────────────────────────
REDDIT_USER_AGENT=tradingagents-deploy
