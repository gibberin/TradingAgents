# ─────────────────────────────────────────────────────────────────────────────
# TradingAgents Viewer — Non-sensitive Configuration (LOCAL DEV ONLY)
#
# This is for docker-compose.yml (build-from-source, no Caddy/TLS/auth).
# Production uses .env.production instead (see .env.production.example and
# DEPLOYMENT.md) — that file also carries the domain/ACME/Basic-Auth values
# Caddy needs, which don't apply here.
#
# API keys and passwords are NOT stored here.
# They live in individual files under ./secrets/ — run this to set them up:
#
#   chmod +x scripts/create_secrets.sh && ./scripts/create_secrets.sh
#
# This .env file only contains non-sensitive configuration that is safe
# to keep in version control or share with teammates.
# ─────────────────────────────────────────────────────────────────────────────

# ── Storage ───────────────────────────────────────────────────────────────────
# Path on your machine to store reports (defaults to ./reports if unset).
REPORTS_HOST_PATH=./reports

# ── Reddit (non-sensitive) ────────────────────────────────────────────────────
# The user-agent string for Reddit API calls — not a secret.
REDDIT_USER_AGENT=tradingagents-deploy
